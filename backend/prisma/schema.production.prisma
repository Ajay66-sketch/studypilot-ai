generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  pro
  premium
}

enum FeatureType {
  summarize
  answer
  questions
  revision
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  password            String
  name                String?
  plan                Plan           @default(free)
  referralCode        String         @unique
  referredById        String?
  referredBy          User?          @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]         @relation("UserReferrals")
  onboardingCompleted Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  sessions            Session[]
  documents           Document[]
  subscriptions       Subscription[]
  usage               Usage?

  @@index([email])
  @@index([referralCode])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([refreshToken])
}

model Document {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  featureType     FeatureType
  subject         String?
  answerMode      String?
  isExamBooster   Boolean     @default(false)
  isFavorite      Boolean     @default(false)
  inputText       String      @db.Text
  outputText      Json
  cachedHash      String
  isPremiumOutput Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, cachedHash])
}

model Usage {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestsUsed  Int      @default(0)
  lastResetDate String
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan
  status            SubscriptionStatus @default(active)
  razorpayPaymentId String
  razorpayOrderId   String?
  razorpaySignature String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([razorpayPaymentId])
}
